FROM localhost/slk-runtime-env:local AS environment
FROM docker.io/postgis/postgis:17-3.6@sha256:d7053f57b0d62c427ffbf412208b6625317124d62eebf40672e990fea81e9d53
COPY --from=environment /slk-env /usr/local/bin/slk-env
COPY --from=environment /usr/share/slk-env /usr/share/slk-env
ENTRYPOINT ["/usr/local/bin/slk-env", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["postgres"]
