FROM docker.io/library/caddy:2.11.9-builder@sha256:345264d8c6b50f44f4a4d507d4e6b6bcae40eef2f210d70f76e717fd8cc31baf AS builder
ENV GOTOOLCHAIN=go1.27.4
WORKDIR /src
COPY go.mod main.go main_test.go ./
RUN go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /slk-env .
FROM scratch
COPY --from=builder /slk-env /slk-env
COPY DOTENV_LICENSE /usr/share/slk-env/DOTENV_LICENSE
