# Root-owned mode 0600. This file is parsed as dotenv data, never sourced.
SLK_LOG_ENDPOINT=https://logs.stadt-land-klima.de/insert/jsonline
SLK_LOG_USERNAME=slk-production
SLK_LOG_PASSWORD_FILE=/root/.config/slk/victorialogs-password
SLK_LOG_HOST=slk-production-1
SLK_LOG_ENVIRONMENT=production
# Optional exact container routes for other trusted production stacks on this host.
# SLK_LOG_CONTAINER_ROUTES='{"campaignmanager_web_1":{"project":"campaignmanager","service":"web"},"campaignmanager_server_1":{"project":"campaignmanager","service":"server"},"campaignmanager_postgres_1":{"project":"campaignmanager","service":"postgresql"}}'
