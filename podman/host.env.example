# Install root-owned mode 0600 at /root/.config/slk/host.env.
# Existing app configuration must explicitly set SLK_DEPLOYMENT_TARGET=production.
SLK_HOST_APP_USER=deploy
SLK_HOST_APP_CONFIG=/home/deploy/.config/slk/future.env
SLK_HOST_BACKUP_CONFIG=/root/.config/staedtechallenge-backup.env
SLK_HOST_BACKUP_HOST=slk-prod
SLK_HOST_BACKUP_TAG=staedtechallenge
# Optional: provision reviewed host journal forwarding (requires reviewed Vector binary).
# SLK_HOST_LOGGING_CONFIG=/root/.config/slk/logging.env
