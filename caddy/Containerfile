# Rate limiting is an explicit dependency: stock Caddy must fail validation.
FROM docker.io/library/caddy:2.11.9-builder@sha256:345264d8c6b50f44f4a4d507d4e6b6bcae40eef2f210d70f76e717fd8cc31baf AS builder
ENV XCADDY_SKIP_CLEANUP=1 GOTOOLCHAIN=go1.27.4
RUN xcaddy build v2.11.9 \
    --with github.com/mholt/caddy-ratelimit@5625512f24f6f59d6f64fb3aafe5eecff0b286db \
    --replace golang.org/x/net=golang.org/x/net@v0.62.0 \
    --output /usr/bin/caddy

# The generic binary scanner reports an OpenPGP advisory against x/crypto as a
# whole. Forbid those unused packages in the exact generated entrypoint graph.
RUN cd /tmp/buildenv_* \
    && go list -mod=readonly -deps -f '{{.ImportPath}}' . > /tmp/slk-imports.txt \
    && if grep -Eq '^golang.org/x/crypto/openpgp(/|$)' /tmp/slk-imports.txt; then \
         echo 'Unsafe OpenPGP package entered the gateway build' >&2; exit 1; \
       fi \
    && cp go.mod /tmp/slk-go.mod && cp go.sum /tmp/slk-go.sum

FROM docker.io/library/caddy:2.11.9-alpine@sha256:0bbb055bda6793c999bde78b1b5ce3e89f829fb031af2cf50056ea1246559fee
RUN apk upgrade --no-cache
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
COPY --from=builder /tmp/slk-imports.txt /tmp/slk-go.mod /tmp/slk-go.sum /usr/share/slk-caddy/
# Runtime uses high container ports with cap_drop ALL; no file capability is needed.
RUN if getcap /usr/bin/caddy | grep -q .; then setcap -r /usr/bin/caddy; fi
USER 1000:1000
ENTRYPOINT ["/usr/bin/caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
