{
  "name": "directus-cli",
  "version": "1.0.0",
  "description": "CLI for directus API",
  "bin": {
    "directus-cli": "./index.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@directus/sdk": "^27.0.0",
    "dotenv": "^18.0.8",
    "lodash": "^4.18.1",
    "pg": "^8.23.1",
    "slugify": "^1.6.9",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "test:tour-migration": "tsx --test migrateSuccessProjectTours.test.ts",
    "typecheck": "tsc --noEmit && tsx scripts/checkSources.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:gates",
    "test:unit": "tsx --test tasks/*.test.ts",
    "build": "npm run typecheck",
    "test:gates": "tsx --test scripts/*.test.ts",
    "test:integration": "tsx --test integration/*.test.ts",
    "test:database-role": "SLK_DATABASE_ROLE_TEST=1 tsx --test integration/databaseRole.test.ts"
  },
  "type": "module",
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "^22.20.5",
    "@types/lodash": "^4.17.23",
    "@types/pg": "^8.15.6",
    "@types/yargs": "^17.0.35"
  }
}
