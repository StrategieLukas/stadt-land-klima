{
  "name": "pdf-service",
  "description": "Generate a PDF for a municipality",
  "icon": "extension",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-endpoint"
  ],
  "type": "module",
  "files": [
    "dist",
    "typst"
  ],
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.0.6",
    "@directus/types": "^18.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "html-to-text": "^10.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.4",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.29",
    "immutable": "^5.1.9",
    "decode-uri-component": "^0.5.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
