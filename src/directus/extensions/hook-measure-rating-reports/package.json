{
  "name": "measure-rating-reports",
  "description": "Please enter a description for your extension",
  "icon": "extension",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-hook"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "test": "tsx --test src/reportCsv.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run typecheck"
  },
  "dependencies": {
    "csv-stringify": "^6.9.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.1.1",
    "@directus/types": "^18.1.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.8",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.5",
    "baseline-browser-mapping": "^2.11.36",
    "immutable": "^5.1.10",
    "decode-uri-component": "0.5.1",
    "postcss-selector-parser": "^7.2.0",
    "zod": "4.6.7"
  }
}
