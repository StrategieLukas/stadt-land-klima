{
  "name": "hook-calc-score-and-ranks",
  "version": "0.1.0",
  "description": "Hook: recalc scores on ratings change, update ranks, safe measure deletion",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run typecheck"
  },
  "keywords": [
    "directus-extension",
    "directus",
    "hook"
  ],
  "author": "your-name",
  "license": "MIT",
  "dependencies": {
    "@directus/errors": "3.0.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.1.1",
    "@directus/types": "^18.1.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.8",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.5",
    "baseline-browser-mapping": "^2.11.36",
    "immutable": "^5.1.10",
    "decode-uri-component": "0.5.1",
    "postcss-selector-parser": "^7.2.0",
    "zod": "4.6.7"
  },
  "directus:extension": {
    "type": "hook",
    "host": "^11.0.0",
    "path": "./dist/index.js",
    "source": "src/index.ts"
  }
}
