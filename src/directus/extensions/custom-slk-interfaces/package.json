{
  "name": "custom-slk-interfaces",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "directus",
    "directus-extension",
    "bundle",
    "interfaces"
  ],
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "data-page-catalog",
        "source": "./src/data-page-catalog/endpoint.ts"
      },
      {
        "type": "interface",
        "name": "auto-slug",
        "source": "./src/auto-slug/index.ts"
      },
      {
        "type": "interface",
        "name": "data-page-collections",
        "source": "./src/data-page-collections/index.ts"
      },
      {
        "type": "interface",
        "name": "footer-nav-editor",
        "source": "./src/footer-nav-editor/index.ts"
      },
      {
        "type": "interface",
        "name": "icon-radio",
        "source": "./src/images-as-radio-buttons/index.ts"
      },
      {
        "type": "interface",
        "name": "measure-preview",
        "source": "./src/measure-infos/index.ts"
      },
      {
        "type": "interface",
        "name": "municipality-scores-publisher",
        "source": "./src/municipality-scores-publisher/index.ts"
      },
      {
        "type": "interface",
        "name": "navigation-editor",
        "source": "./src/navigation-editor/index.ts"
      },
      {
        "type": "interface",
        "name": "unsplash-image",
        "source": "./src/unsplash-image/index.ts"
      },
      {
        "type": "hook",
        "name": "data-page-config-validation",
        "source": "./src/data-page-config-validation/index.ts"
      },
      {
        "type": "hook",
        "name": "public-assets",
        "source": "./src/public-assets/index.ts"
      },
      {
        "type": "hook",
        "name": "security-audit",
        "source": "./src/security-audit/index.ts"
      }
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run typecheck"
  },
  "dependencies": {
    "@directus/errors": "^2.5.2",
    "slugify": "^1.6.9",
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.0.6",
    "@directus/types": "^18.0.0",
    "esbuild": "^0.28.2",
    "sass": "^1.105.2",
    "typescript": "^5.9.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13",
    "@types/express": "^4.17.25"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.4",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.29",
    "immutable": "^5.1.9",
    "decode-uri-component": "^0.5.0",
    "postcss-selector-parser": "^7.1.6",
    "zod": "4.6.7"
  }
}
