{
  "name": "consent-management",
  "version": "1.0.0",
  "description": "Consent management system with hook, module, and endpoint functionality",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run typecheck"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "consent",
    "agreements"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "markdown-it": "^15.0.3",
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vue": "3.5.43",
    "@directus/types": "^18.0.0",
    "vue-tsc": "3.3.13",
    "@types/express": "^4.17.25"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.4",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.29",
    "immutable": "^5.1.9",
    "decode-uri-component": "^0.5.0",
    "postcss-selector-parser": "^7.1.6",
    "zod": "4.6.7"
  },
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "hook",
        "name": "hook-consent-check",
        "source": "src/consent/hook/index.ts"
      },
      {
        "type": "module",
        "name": "module-consent",
        "source": "src/consent/module/index.ts"
      },
      {
        "type": "endpoint",
        "name": "endpoint-consent",
        "source": "src/consent/endpoint/index.ts"
      }
    ]
  }
}
