{
  "name": "erfolgsprojekte-user-manager",
  "description": "Directus invitations for article editors and admin-selected human roles.",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "erfolgsprojekte-user-manager-endpoint",
        "source": "src/endpoint/index.ts"
      },
      {
        "type": "panel",
        "name": "erfolgsprojekte-user-manager-panel",
        "source": "src/panel/index.ts"
      },
      {
        "type": "endpoint",
        "name": "role-invitations-endpoint",
        "source": "src/admin-endpoint/index.ts"
      },
      {
        "type": "module",
        "name": "role-invitations-module",
        "source": "src/module/index.ts"
      }
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run typecheck"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.1.1",
    "@directus/types": "^18.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.14",
    "@types/express": "^4.17.25"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.8",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.5",
    "baseline-browser-mapping": "^2.11.36",
    "immutable": "^5.1.10",
    "decode-uri-component": "0.5.1",
    "postcss-selector-parser": "^7.2.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
