{
  "name": "editor-manager",
  "description": "Bundle: add-editor + delete-editor operations for managing LokalteamMitglied editors",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "directus-extension-operation"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "operation",
        "name": "operation-add-editor",
        "source": {
          "app": "src/add-editor/app.ts",
          "api": "src/add-editor/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "delete-editor",
        "source": {
          "app": "src/delete-editor/app.ts",
          "api": "src/delete-editor/api.ts"
        }
      }
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run typecheck"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.0.6",
    "@directus/types": "^18.0.0",
    "@types/lodash-es": "^4.17.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vue": "3.5.43"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.4",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.29",
    "immutable": "^5.1.9",
    "decode-uri-component": "^0.5.0",
    "postcss-selector-parser": "^7.1.6",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@directus/errors": "^2.5.2"
  }
}
