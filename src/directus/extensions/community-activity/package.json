{
  "name": "community-activity",
  "description": "Directus dashboard panel and endpoint for Lokalteam activity monitoring.",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "community-activity-endpoint",
        "source": "src/endpoint/index.ts"
      },
      {
        "type": "panel",
        "name": "community-activity-panel",
        "source": "src/panel/index.ts"
      }
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run typecheck"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.0.6",
    "@directus/types": "^18.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13",
    "@types/express": "^4.17.25"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.4",
    "svgo": "^4.1.0",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.29",
    "immutable": "^5.1.9",
    "decode-uri-component": "^0.5.0",
    "postcss-selector-parser": "^7.1.6",
    "zod": "4.6.7"
  }
}
