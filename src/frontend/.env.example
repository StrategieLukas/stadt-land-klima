APP_ENV=development
SERVER_DIRECTUS_URL=http://directus:8055
CLIENT_DIRECTUS_URL=http://localhost:8081
PUBLIC_URL=http://localhost:8080
FALLBACK_LOCALE=de-DE
HOST=0.0.0.0
# Private Frontend-Server identity, provisioned after importing roles/policies.
# Production runtime override: NUXT_DIRECTUS_FRONTEND_SERVER_TOKEN.
DIRECTUS_FRONTEND_SERVER_TOKEN=
# Do not restore the obsolete browser-visible DIRECTUS_TOKEN.
# Server-only CARTO basemap key for the same-origin tile proxy.
# Request one at https://carto.com/basemaps/apikey/.
CARTO_BASEMAP_API_KEY=
PLAUSIBLE_ANALYTICS_URL=url_to_plausible_analytics_instance
PLAUSIBLE_ANALYTICS_DOMAIN=domain_as_registered_in_plausible_analytics
PLAUSIBLE_UTM_CAMPAIGN=maintenance_mode
NODE_OPTIONS=--max-old-space-size=2048
# Avoid server going out of RAM when updating dependencies
npm_config_jobs=2
# Stadtlandzahl upstream (no trailing slash or path). The optional server URL
# can point to a Docker-internal hostname while BASE_URL remains the public URL.
STADTLANDZAHL_BASE_URL=https://data2.stadt-land-klima.de
STADTLANDZAHL_SERVER_BASE_URL=
STADTLANDZAHL_BASE_HTTP_BASIC_AUTH_USER=
STADTLANDZAHL_BASE_HTTP_BASIC_AUTH_PASSWORD=

# Optional frontend-only basic auth. Leave both empty/unset to disable it.
FRONTEND_BASIC_AUTH_USERNAME=
FRONTEND_BASIC_AUTH_PASSWORD=

# Registration: admin notification email recipient
ADMIN_NOTIFICATION_EMAIL=info@stadt-land-klima.de

# Erfolgsprojekte: notification email recipient
ERFOLGSPROJEKTE_NOTIFICATION_EMAIL=presse@stadt-land-klima.de

# Public Blökkli forms: fallback notification email recipient
FORM_RESPONSE_NOTIFICATION_EMAIL=info@stadt-land-klima.de

# Server-only listmonk API configuration. LISTMONK_LIST_ID is the numeric default
# list used by footer and registration signups (the CMS block can select public lists).
# Use an active public list configured for double opt-in to send confirmation mail.
LISTMONK_ENDPOINT=
LISTMONK_API_USERNAME=
LISTMONK_API_TOKEN=
LISTMONK_LIST_ID=

# Registration: welcome email link targets
WELCOME_EMAIL_TUTORIAL_URL=
WELCOME_EMAIL_CALENDAR_URL=
WELCOME_EMAIL_SIGNAL_URL=

ALTCHA_SECRET=dev-secret-change-in-production
# Server-only token of an active Directus Administrator. Never reuse the public DIRECTUS_TOKEN.
DIRECTUS_ADMIN_TOKEN=

# Private Frontend-Preview verifier, provisioned after importing roles/policies.
# Production runtime override: NUXT_DIRECTUS_PREVIEW_TOKEN. Never place under public.
DIRECTUS_PREVIEW_TOKEN=

# Server-only mail webhook URLs (set after importing flows). Both require the
# administrator token above. Public Directus URL aliases are supported; authenticated
# requests always use SERVER_DIRECTUS_URL and only reuse the flow UUID from these URLs.
# Replace <flow-id> with each imported flow's actual UUID, not its name.
DIRECTUS_FLOW_NOTIFY_ADMIN=http://directus:8055/flows/trigger/<flow-id>
DIRECTUS_FLOW_WELCOME_EMAIL=http://directus:8055/flows/trigger/<flow-id>

# Optional independent encrypted candidate-session key (at least 32 random characters).
# If empty, a domain-separated key is derived from the private ALTCHA_SECRET.
CANDIDATE_SESSION_SECRET=
# Optional independent website-editor cookie key (at least 32 random characters).
# Directus access/refresh tokens remain in Redis. Empty derives from ALTCHA_SECRET.
EDITOR_SESSION_SECRET=
# Plausible uses the reviewed local asset and generated SRI manifest.
# Repin explicitly with: node scripts/pin-plausible.mts <public-https-script-url>
# Production ALTCHA_SECRET must be unique, non-development and at least 32 characters.
# Production Compose CORS defaults are overridden via SLK_ALLOWED_ORIGINS when staging differs.

# Prepared CMS translations. Disabled until the private schema/extension and identity are installed.
# Pages only read stored translations; only the background worker can contact DeepL.
CONTENT_TRANSLATION_ENABLED=false
# Provision with src/directus/cli/provisionTranslationWorker.ts. Never put this token under public.
CONTENT_TRANSLATION_WORKER_TOKEN=
DEEPL_API_KEY=
# auto selects api-free.deepl.com for legacy :fx keys, otherwise api.deepl.com. No fallback host.
DEEPL_API_ENDPOINT=auto
DEEPL_MODEL=prefer_quality_optimized
DEEPL_GLOSSARY_EN=
DEEPL_GLOSSARY_IT=
# Deliberate changes require operator enqueue of the resulting namespace; keep stable to reuse memory.
DEEPL_POLICY_REVISION=v1
# Character limits live in src/directus/.env, not browser or per-worker configuration.
