import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { dirname, resolve, relative } from "node:path";
import { fileURLToPath } from "node:url";
import ts from "typescript";
import { parse } from "@vue/compiler-sfc";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
function files(directory: string): string[] {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    if (["node_modules", ".nuxt", ".output", "dist", "public", "scripts", "server"].includes(entry.name)) return [];
    const file = resolve(directory, entry.name);
    return entry.isDirectory() ? files(file) : /\.(?:ts|vue)$/.test(entry.name) ? [file] : [];
  });
}
function apiFiles(directory: string): string[] {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const file = resolve(directory, entry.name);
    return entry.isDirectory() ? apiFiles(file) : entry.name.endsWith(".ts") ? [file] : [];
  });
}
const events = new Set(["client.vue_failed", "client.app_failed", "client.promise_unhandled", "client.runtime_failed"]);
for (const file of files(root)) {
  if (file === resolve(root, "shared/securityLog.ts")) continue;
  const source = readFileSync(file, "utf8");
  const descriptor = file.endsWith(".vue") ? parse(source).descriptor : undefined;
  const scripts = descriptor
    ? [descriptor.script?.content, descriptor.scriptSetup?.content].filter(
        (value): value is string => value !== undefined,
      )
    : [source];
  for (const script of scripts) {
    const tree = ts.createSourceFile(file, script, ts.ScriptTarget.Latest, true);
    function visit(node: ts.Node) {
      if (
        ts.isCallExpression(node) &&
        ts.isIdentifier(node.expression) &&
        ["clientDiagnostic", "clientFailure"].includes(node.expression.text)
      ) {
        const event = node.arguments[0];
        if (!event || !ts.isStringLiteral(event))
          throw new Error(`Client diagnostics need a fixed event in ${relative(root, file)}`);
        events.add(event.text);
      }
      ts.forEachChild(node, visit);
    }
    visit(tree);
  }
}
const api = resolve(root, "server/api");
const routes = Array.from(
  new Set(
    apiFiles(api).map(
      (file) =>
        "/api/" +
        relative(api, file)
          .replaceAll("\\", "/")
          .replace(/\.ts$/, "")
          .replace(/\.(?:get|post|put|patch|delete|head|options)$/, "")
          .replace(/(^|\/)index$/, "$1")
          .replace(/\/$/, "")
          .replace(/\[\.\.\.([^\]]+)\]/g, ":$1*")
          .replace(/\[([^\]]+)\]/g, ":$1"),
    ),
  ),
).sort(
  (a, b) =>
    b.split("/").length - a.split("/").length ||
    Number(a.includes(":")) - Number(b.includes(":")) ||
    a.localeCompare(b),
);
const outputs = [
  [
    "shared/securityLogRoutes.ts",
    "Static route templates; never parameter values or query strings.",
    "SECURITY_LOG_ROUTES",
    routes,
  ],
  [
    "shared/securityClientEvents.ts",
    "Fixed client event codes; no messages, URLs, stacks or arbitrary metadata.",
    "SECURITY_CLIENT_EVENTS",
    Array.from(events).sort(),
  ],
] as const;
for (const [path, description, name, values] of outputs) {
  const source = `/** ${description} Generated by scripts/generate-security-log-manifests.mts. */\nexport const ${name} = [\n${values.map((value) => "  " + JSON.stringify(value) + ",").join("\n")}\n] as const;\n`;
  const file = resolve(root, path);
  if (process.argv.includes("--check")) {
    if (readFileSync(file, "utf8") !== source)
      throw new Error("Security log manifest drift; run npm run logging:generate");
  } else writeFileSync(file, source);
}
console.info(
  JSON.stringify({
    event: "logging.manifests.checked",
    userId: null,
    actorType: "system",
    severity: "info",
    count: routes.length + events.size,
  }),
);
