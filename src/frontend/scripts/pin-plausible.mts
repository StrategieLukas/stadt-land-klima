import {createHash} from 'node:crypto';
import {mkdirSync, writeFileSync} from 'node:fs';

const source = new URL(process.argv[2] || 'https://analytics.stadt-land-klima.de/js/script.js');
if (source.protocol !== 'https:' || source.username || source.password) throw new Error('Expected a public HTTPS tracker URL');
const response = await fetch(source, {redirect: 'error', signal: AbortSignal.timeout(15_000)});
if (!response.ok) throw new Error('Tracker download failed');
const original = await response.text();
if (Buffer.byteLength(original) > 65536) throw new Error('Tracker size requires review');
const marker = 'function a(t,n,e){';
if (original.split(marker).length !== 2 || !original.includes('window.plausible.v=33')) throw new Error('Tracker implementation changed; review the privacy guard before repinning');
// Pin the reviewed tracker and guard its one delivery function, including SPA transitions.
const guard = `try{var s=new URL(n.u||location.href),c=new URL(location.href);if([s,c].some(function(u){return /^\\/elections\\/thesen(?:\\/|$)/.test(u.pathname)||['preview','preview_token','blokkliPreview','access_token','token'].some(function(k){return u.searchParams.has(k)||new URLSearchParams(u.hash.slice(1)).has(k)})})){e&&e.callback&&e.callback({status:204});return}}catch(_){return}`;
const script = original.replace(marker, marker + guard);
const digest = createHash('sha256').update(script).digest('hex');
const integrity = 'sha384-' + createHash('sha384').update(script).digest('base64');
const filename = `plausible-v33-${digest.slice(0, 12)}.js`;
const directory = new URL('../public/vendor/plausible/', import.meta.url);
mkdirSync(directory, {recursive: true});
writeFileSync(new URL(filename, directory), script);
writeFileSync(new URL('../shared/plausibleManifest.ts', import.meta.url), `// Generated by scripts/pin-plausible.mts; reviewed tracker v33 with private-route delivery guard.\nexport const plausibleManifest = ${JSON.stringify({src: '/vendor/plausible/' + filename, integrity, source: source.href, sourceSha256: createHash('sha256').update(original).digest('hex')}, null, 2)} as const;\n`);
console.log('Pinned reviewed Plausible tracker bytes, source digest, privacy guard and SRI hash.');
