{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/patch-node-forge.mts && nuxt prepare",
    "lint:js": "eslint . --max-warnings 0",
    "lint:prettier": "npm run format:check",
    "lint": "npm run lint:js",
    "lintfix": "npm run lint:js -- --fix",
    "lintExtensions:js": "cd ../directus/extensions && ../../frontend/node_modules/.bin/eslint --config ../../frontend/eslint.extensions.config.mjs '**/src/**/*.{ts,vue}' --max-warnings 0 'shared/**/*.ts'",
    "lintExtensions:prettier": "prettier --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --check \"../directus/extensions/*/src/**/*.{js,ts,vue}\"",
    "lintExtensions": "npm run lintExtensions:js",
    "lintfixExtensions": "npm run lintExtensions:js -- --fix",
    "typecheck": "npm run security:check && npm run translations:check && npm run logging:check && bash typecheck.sh && npm run typecheck:coverage && npm run lint:types && npm run typecheck:scripts && npm run typecheck:tooling",
    "typecheck:full": "nuxt prepare && vue-tsc -b --noEmit",
    "prebuild": "npm run typecheck",
    "pregenerate": "npm run typecheck",
    "translations:generate": "node scripts/generate-translations.mts",
    "translations:check": "node scripts/generate-translations.mts --check",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "lint:types": "eslint \"**/*.ts\" \"**/*.mts\" \"**/*.vue\" --max-warnings 0",
    "typecheck:coverage": "node scripts/check-type-coverage.mts",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "format:check": "node scripts/format-project.mts --check",
    "format": "node scripts/format-project.mts --write",
    "security:check": "node scripts/patch-node-forge.mts --check",
    "logging:generate": "node scripts/generate-security-log-manifests.mts",
    "logging:check": "node scripts/generate-security-log-manifests.mts --check"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.4.4",
    "@nuxt/eslint-config": "1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-force": "3.0.10",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "baseline-browser-mapping": "^2.11.29",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "nuxt": "4.6.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@apollo/client": "^4.3.4",
    "@blokkli/editor": "2.0.0-alpha.73",
    "@directus/sdk": "^27.0.0",
    "@iconify/json": "^2.2.545",
    "@iconify/vue": "^5.0.3",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@nuxtjs/leaflet": "^1.3.3",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "altcha": "^3.4.1",
    "chart.js": "^4.5.1",
    "chartjs-chart-treemap": "^4.2.2",
    "daisyui": "5.7.50",
    "dom-serializer": "3.1.1",
    "entities": "^8.1.0",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "html-to-image": "^1.11.13",
    "htmlparser2": "12.0.0",
    "leaflet": "^1.9.4",
    "linkify-string": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lodash": "^4.18.1",
    "maplibre-gl": "^6.15.0",
    "markdown-it": "^15.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.1",
    "meilisearch": "^0.62.0",
    "micromark-extension-gfm": "3.0.0",
    "ml-pca": "^4.1.1",
    "nuxt-security": "2.6.0",
    "postcss": "^8.5.31",
    "redis": "^6.3.0",
    "sanitize-html": "^2.18.1",
    "slugify": "^1.6.9",
    "tailwindcss": "4.3.3",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-geo": "^5.1.3",
    "vega-lite": "^6.5.0",
    "vue-chartjs": "^5.3.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "listhen": {
      "node-forge": "1.4.0"
    }
  }
}
