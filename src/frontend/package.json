{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lintfix": "prettier --write --list-different . && npm run lint:js -- --fix",
    "lintExtensions:js": "cd ../directus/extensions && ../../frontend/node_modules/.bin/eslint --config ../../frontend/eslint.config.mjs --ext .js,.ts,.vue .",
    "lintExtensions:prettier": "prettier --check \"../directus/extensions/*/src/**/*.{js,ts,vue}\"",
    "lintExtensions": "npm run lintExtensions:js && npm run lintExtensions:prettier",
    "lintfixExtensions": "prettier --write \"../directus/extensions/*/src/**/*.{js,ts,vue}\" && npm run lintExtensions:js -- --fix",
    "typecheck": "bash typecheck.sh && npm run lint:migrated",
    "typecheck:full": "nuxt prepare && vue-tsc -b --noEmit",
    "typecheck:baseline": "bash typecheck.sh --update-baseline",
    "lint:migrated": "eslint shared/contracts/*.ts server/types/directus.ts server/utils/candidateAnswers.ts server/api/public/jobs.get.ts \"server/api/public/jobs/[slug].get.ts\" \"server/api/candidate/[token]/answers.post.ts\" components/JobOfferCard.vue components/JobOfferStatusPill.vue pages/jobs/index.vue \"pages/jobs/[slug].vue\"",
    "prebuild": "npm run typecheck",
    "pregenerate": "npm run typecheck"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.4.4",
    "@nuxt/eslint-config": "1.17.0",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "baseline-browser-mapping": "^2.11.29",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "nuxt": "4.6.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  },
  "dependencies": {
    "@apollo/client": "^4.3.4",
    "@blokkli/editor": "2.0.0-alpha.73",
    "@directus/sdk": "^27.0.0",
    "@iconify/json": "^2.2.545",
    "@iconify/vue": "^5.0.3",
    "@nuxtjs/leaflet": "^1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "altcha": "^3.4.1",
    "autoprefixer": "^10.6.1",
    "chart.js": "^4.5.1",
    "chartjs-chart-treemap": "^4.2.2",
    "daisyui": "^4.12.24",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "linkify-string": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lodash": "^4.18.1",
    "maplibre-gl": "^6.15.0",
    "markdown-it": "^15.0.3",
    "meilisearch": "^0.62.0",
    "ml-pca": "^4.1.1",
    "postcss": "^8.5.31",
    "sanitize-html": "^2.18.1",
    "slugify": "^1.6.9",
    "tailwindcss": "^3.4.19",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-geo": "^5.1.3",
    "vega-lite": "^6.5.0",
    "vue-chartjs": "^5.3.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "postcss-nested": "^7.0.2"
  }
}
