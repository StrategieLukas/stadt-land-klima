{
  "extends": "./.nuxt/tsconfig.app.json",
  "include": [
    "components/**/*.vue",
    "pages/**/*.vue",
    "types/**/*.d.ts",
    ".nuxt/nuxt.d.ts",
    ".nuxt/imports.d.ts",
    ".nuxt/components.d.ts",
    ".nuxt/types/**/*.d.ts"
  ],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": [],
    "htmlAttributes": ["aria-*", "data-*", "title"],
    "fallthroughAttributes": true,
    "checkUnknownEvents": true
  }
}
