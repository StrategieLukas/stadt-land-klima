{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Directus thesis_topics import",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "description", "categories"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "Omit to let Directus generate a UUID for a new topic."
      },
      "title": {
        "type": "string",
        "maxLength": 255,
        "pattern": "\\S"
      },
      "short_description": {
        "type": ["string", "null"],
        "maxLength": 255,
        "description": "Optional plain-text preview shown on the collapsed card."
      },
      "description": {
        "type": "string",
        "pattern": "\\S",
        "description": "Detailed Markdown description shown after the card is expanded."
      },
      "categories": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "enum": [
            "political_science",
            "public_administration",
            "computer_and_data_science",
            "climate_action_management",
            "climate_and_environmental_engineering"
          ]
        }
      },
      "levels": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "default": ["bachelor", "master", "phd"],
        "items": {
          "enum": ["bachelor", "master", "phd"]
        }
      },
      "status": {
        "enum": ["published", "in_progress", "completed"],
        "default": "published",
        "description": "Only published topics appear on the website."
      }
    }
  }
}
