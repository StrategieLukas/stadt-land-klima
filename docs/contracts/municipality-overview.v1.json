              "percentage_representation": {
                "type": "string",
                "enum": ["none", "fraction", "percent"]
              },
              "normalization": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["none", "population"]
                  },
                  "per": {
                    "anyOf": [
