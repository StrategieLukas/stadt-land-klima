                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^#[a-fA-F0-9]{6}$"
                        }
                      },
                      "required": ["id", "label", "color"]
                    }
