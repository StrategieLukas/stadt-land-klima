# Opaque JSON deep input bypasses the upstream query parser's prototype protection.
# Query credentials and incoming Referer values must never enter access logs.
# Legacy path invitations are additionally excluded in their location below.
log_format slk_safe '$remote_addr - $remote_user [$time_local] '
  '"$request_method $uri $server_protocol" $status $body_bytes_sent '
  '"$http_user_agent"';

map $args $slk_opaque_deep {
  default 0;
  ~*(^|&)(d|%64)(e|%65)(e|%65)(p|%70)= 1;
}

# Preserve no-referrer on invitation/private preview requests even when nginx
# adds its site policy alongside the application's response headers.
map $request_uri $slk_referrer_policy {
  default "strict-origin-when-cross-origin";
  ~^/(?:elections/thesen|api/candidate)(?:/|\?|$) "no-referrer";
  ~[?&](?:preview|preview_token|blokkliPreview|access_token|token)= "no-referrer";
}

# Rate limiting zones — protect public endpoints from abuse
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=frontend:10m rate=30r/s;
limit_req_status 429;

# HTTP server
server {
  listen 80;
  listen [::]:80;

  server_name stadt-land-klima.de;
  server_tokens off;

  # redirect anything to https
  return 301 https://www.$http_host$request_uri;


  access_log  /var/log/nginx/stadt-land-klima.de_access.log slk_safe;
  error_log   /var/log/nginx/stadt-land-klima.de_error.log;
}

# HTTP server
server {
  listen 80;
  listen [::]:80;

  server_name www.stadt-land-klima.de;
  server_tokens off;

  # redirect anything to https
  return 301 https://$http_host$request_uri;


  access_log  /var/log/nginx/stadt-land-klima.de_access.log slk_safe;
  error_log   /var/log/nginx/stadt-land-klima.de_error.log;
}

# HTTPS server
server {
  # SSL configuration
  #
  listen 443 ssl http2;
	listen [::]:443 ssl http2;

  ## Strong SSL Security
  ## https://raymii.org/s/tutorials/Strong_SSL_Security_On_nginx.html & https://cipherli.st/
  ssl_certificate /etc/letsencrypt/live/stadt-land-klima.de/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/stadt-land-klima.de/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ecdh_curve X25519:prime256v1:secp384r1;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 5m;

  server_name stadt-land-klima.de;
  server_tokens off;
  return 301 https://www.$http_host$request_uri;

  access_log  /var/log/nginx/stadt-land-klima.de_access.log slk_safe;
  error_log   /var/log/nginx/stadt-land-klima.de_error.log;
}

# HTTPS server
server {
  # SSL configuration
  #
  listen 443 ssl http2;
	listen [::]:443 ssl http2;

  ## Strong SSL Security
  ## https://raymii.org/s/tutorials/Strong_SSL_Security_On_nginx.html & https://cipherli.st/
  ssl_certificate /etc/letsencrypt/live/www.stadt-land-klima.de/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/www.stadt-land-klima.de/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ecdh_curve X25519:prime256v1:secp384r1;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 5m;

  server_name www.stadt-land-klima.de;
  server_tokens off;

  # The frontend supplies its per-response nonce policy. This fallback also protects CMS responses.
  proxy_buffer_size 16k;
  proxy_buffers 8 16k;
  proxy_busy_buffers_size 32k;
  proxy_hide_header X-Powered-By;
  proxy_hide_header Server;
  # Security headers
  add_header X-Permitted-Cross-Domain-Policies "none" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
  add_header Referrer-Policy $slk_referrer_policy always;
  add_header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;

  # The site uses REST; StadtLandZahl's separate GraphQL proxy is unaffected.
  location ~* ^/backend/(?:graphql|utils/hash)(?:/|$) {
    return 403;
  }

  location /backend/ {
    if ($slk_opaque_deep) { return 400; }
    if ($http_upgrade != "") { return 403; }
    limit_req zone=api burst=20 nodelay;
    # restrict access
    # auth_basic  "stage";
    # auth_basic_user_file  /var/www/staedtechallenge.anzui.dev/.htpasswd;

    proxy_pass http://127.0.0.1:9001/;
    proxy_intercept_errors on;
    error_page 502 503 504 = @maintenance_page;
    client_max_body_size 512M;
    proxy_connect_timeout       3600;
    proxy_send_timeout          3600;
    proxy_read_timeout          3600;
    send_timeout                3600;
    proxy_max_temp_file_size 512M;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Directus AI chat endpoint — the blokkli editor makes requests to /ai/chat
  # relative to the page origin, so it lands here instead of /backend/
  location /ai/ {
    proxy_pass http://127.0.0.1:9001/ai/;
    client_max_body_size 10M;
    proxy_connect_timeout       3600;
    proxy_send_timeout          3600;
    proxy_read_timeout          3600;
    send_timeout                3600;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Legacy invitation paths contain bearer credentials. Keep them out of access logs.
  location ~ ^/(?:api/candidate(?:/|$)|elections/thesen(?:/|$)) {
    access_log off;
    limit_req zone=frontend burst=60 nodelay;
    proxy_pass http://127.0.0.1:9000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    limit_req zone=frontend burst=60 nodelay;
    # restrict access
    # auth_basic  "stage";
    # auth_basic_user_file  /var/www/stadt-land-klima.de/.htpasswd;

    proxy_pass http://127.0.0.1:9000;
    proxy_intercept_errors on;
    error_page 502 503 504 = @maintenance_page;
    client_max_body_size 512M;
    proxy_connect_timeout       3600;
    proxy_send_timeout          3600;
    proxy_read_timeout          3600;
    send_timeout                3600;
    proxy_max_temp_file_size 512M;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location @maintenance_page {
    proxy_pass http://127.0.0.1:9090;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  access_log  /var/log/nginx/stadt-land-klima.de_access.log slk_safe;
  error_log   /var/log/nginx/stadt-land-klima.de_error.log;
}
