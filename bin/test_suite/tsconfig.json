{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "paths": {
      "~/*": [
        "../../src/frontend/*"
      ],
      "#blokkli/types": [
        "../../src/frontend/node_modules/@blokkli/editor/dist/runtime/types/index.d.ts"
      ],
      "#blokkli/editor/types/state": [
        "../../src/frontend/node_modules/@blokkli/editor/dist/runtime/editor/types/state.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
