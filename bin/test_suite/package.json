{
  "name": "slk-test-suite",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && tsx src/run.ts",
    "test:blokkli": "tsx --test src/blokkliPersistence.test.ts",
    "test:blokkli:adapter": "tsx --test src/blokkliAdapter.test.ts",
    "test:mail-client": "tsx --test src/mailFlowClient.test.ts",
    "test:security:preview": "tsx src/previewSecurity.ts",
    "test:security:migration": "tsx src/securityMigration.ts",
    "test:security:helpers": "tsx --test src/disclosure.test.ts",
    "test:contracts": "tsx --test src/contracts.test.ts src/typecheckGate.test.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/roleInvitations.test.ts src/projectMap.test.ts src/seo.test.ts src/contentTranslation.test.ts src/deepLTranslation.test.ts src/podman.test.ts src/securityLogging.test.ts src/municipalityPublishing.test.ts src/municipalityClimateRegion.test.ts src/productionOutput.test.ts src/images.test.ts src/dataPageDelivery.test.ts src/releasePolicy.test.ts src/framingPolicy.test.ts src/searchReconciliation.test.ts src/uiFixes.test.ts src/municipalityUx.test.ts src/browserCertificate.test.ts src/cssMigration.test.ts src/contracts.test.ts src/typecheckGate.test.ts src/blokkliAdapter.test.ts src/mailFlowClient.test.ts src/disclosure.test.ts src/publicReads.test.ts src/newsDates.test.ts src/phase4.test.ts src/phase5.test.ts src/phase6.test.ts src/phase7.test.ts src/phase8.test.ts src/directusExtensions.test.ts src/securityHardening.test.ts src/lintGate.test.ts src/nodeForge.test.ts src/dependencyAudit.test.ts && npm run test:cli",
    "test:role-invitations:live": "tsx src/roleInvitationsSmoke.ts",
    "test:role-invitations": "tsx --test src/roleInvitations.test.ts",
    "test:municipality-ux:live": "tsx src/municipalityUxSmoke.ts",
    "test:project-map:live": "tsx src/projectMapSmoke.ts",
    "test:project-map": "tsx --test src/projectMap.test.ts",
    "test:seo": "tsx --test src/seo.test.ts && tsx src/seoSmoke.ts",
    "test:public": "tsx src/publicSmoke.ts",
    "test:wahlcheck-embed": "tsx src/wahlcheckEmbed.ts",
    "test:components": "tsx --test src/phase5.test.ts",
    "test:boundaries": "tsx --test src/phase7.test.ts src/blokkliAdapter.test.ts",
    "test:pages": "tsx --test src/phase6.test.ts",
    "test:tours": "tsx src/tours.ts",
    "test:extensions": "tsx --test src/directusExtensions.test.ts",
    "test:cli": "npm --prefix ../../src/directus/cli run test:unit",
    "audit:dependencies": "tsx src/dependencyAudit.ts",
    "test:security:csp": "tsx src/cspProduction.ts",
    "test:core:logical": "tsx src/coreLogicalMigration.ts",
    "test:security:redis": "tsx src/securityRedis.ts",
    "test:security:nginx": "tsx src/nginxSecurity.ts",
    "test:styles": "tsx src/cssMigration.ts",
    "test:security:image": "tsx src/directusImageSecurity.ts",
    "audit:directus-image": "tsx src/directusImageAudit.ts",
    "audit:directus-image:reviewed": "tsx src/directusImageAudit.ts --reviewed",
    "test:podman": "tsx src/podmanRuntime.ts",
    "test:security:caddy": "tsx src/caddySecurity.ts",
    "test:content-translation": "tsx --test src/contentTranslation.test.ts src/deepLTranslation.test.ts",
    "plan:content-translation": "tsx src/contentTranslationPlan.ts",
    "test:content-translation:database": "SLK_TRANSLATION_DATABASE_TEST=1 tsx --test src/contentTranslationDatabase.test.ts",
    "translation:namespace": "tsx src/deepLNamespace.ts",
    "sample:content-translation": "tsx src/contentTranslationSample.ts",
    "test:content-translation:reader": "SLK_TRANSLATION_READER_TEST=1 tsx --test src/contentTranslationReader.test.ts",
    "test:ui-feedback": "tsx src/uiFeedbackSmoke.ts",
    "test:data-page": "tsx --test src/dataPageDelivery.test.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  }
}
