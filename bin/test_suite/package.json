{
  "name": "slk-test-suite",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && tsx src/run.ts",
    "test:blokkli": "tsx --test src/blokkliPersistence.test.ts",
    "test:blokkli:adapter": "tsx --test src/blokkliAdapter.test.ts",
    "test:mail-client": "tsx --test src/mailFlowClient.test.ts",
    "test:security:preview": "tsx src/previewSecurity.ts",
    "test:security:migration": "tsx src/securityMigration.ts",
    "test:security:helpers": "tsx --test src/disclosure.test.ts",
    "test:contracts": "tsx --test src/contracts.test.ts src/typecheckGate.test.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/contracts.test.ts src/typecheckGate.test.ts src/blokkliAdapter.test.ts src/mailFlowClient.test.ts src/disclosure.test.ts src/publicReads.test.ts src/newsDates.test.ts src/phase4.test.ts src/phase5.test.ts src/phase6.test.ts src/phase7.test.ts src/phase8.test.ts src/directusExtensions.test.ts src/securityHardening.test.ts && npm run test:cli",
    "test:public": "tsx src/publicSmoke.ts",
    "test:components": "tsx --test src/phase5.test.ts",
    "test:boundaries": "tsx --test src/phase7.test.ts src/blokkliAdapter.test.ts",
    "test:pages": "tsx --test src/phase6.test.ts",
    "test:tours": "tsx src/tours.ts",
    "test:extensions": "tsx --test src/directusExtensions.test.ts",
    "test:cli": "npm --prefix ../../src/directus/cli run test:unit",
    "audit:dependencies": "tsx src/dependencyAudit.ts",
    "test:security:redis": "tsx src/securityRedis.ts",
    "test:security:nginx": "tsx src/nginxSecurity.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  }
}
